	/// Średnia dobowa temperatura (IMGW).
	column 'Temperatura średnia' = CALCULATE ( AVERAGE ( FactRynek[Temperatura] ) )
		dataType: double
		formatString: 0.0" °C"
		lineageTag: 12c2fc1e-41a0-503b-b83a-e39521208cc8
		summarizeBy: none

		annotation SummarizationSetBy = User

	/// 92 / 96 / 100 – doby zmiany czasu mają inną liczbę kwadransów.
	column 'Kwadransów w dobie' = CALCULATE ( COUNTROWS ( FactRynek ) )
		dataType: int64
		formatString: 0
		lineageTag: 5ca74dcd-ccc4-584a-96e9-1d3e369a943e
		summarizeBy: none

		annotation SummarizationSetBy = User

	partition DimData = m
		mode: import
		queryGroup: 'Tabele modelu'
		source =
				// Kalendarz: typ dnia (roboczy / sobota / niedziela lub święto), miesiące, sezon grzewczy, okna analizy.
				let
				    Od = Okna[PierwszaDoba],
				    Do = Okna[OstatniaDoba],
				    Daty = List.Dates(Od, Duration.Days(Do - Od) + 1, #duration(1, 0, 0, 0)),
				    Tabela = Table.FromList(Daty, Splitter.SplitByNothing(), type table [Data = date]),
				    MiesiaceKrotkie = {"sty", "lut", "mar", "kwi", "maj", "cze", "lip", "sie", "wrz", "paź", "lis", "gru"},
				    DniTygodnia = {"pon", "wt", "śr", "czw", "pt", "sob", "nd"},
				    ZSwietem = Table.NestedJoin(Tabela, {"Data"}, Swieta, {"Data"}, "Sw", JoinKind.LeftOuter),
				    NazwaSwieta = Table.AddColumn(ZSwietem, "NazwaŚwięta", each if Table.IsEmpty([Sw]) then null else [Sw]{0}[NazwaSwieta], type nullable text),
				    BezSw = Table.RemoveColumns(NazwaSwieta, {"Sw"}),
				    Rok = Table.AddColumn(BezSw, "Rok", each Date.Year([Data]), Int64.Type),
				    Miesiac = Table.AddColumn(Rok, "Miesiąc", each Date.Month([Data]), Int64.Type),
				    MiesiacNazwa = Table.AddColumn(Miesiac, "MiesiącNazwa", each MiesiaceKrotkie{[Miesiąc] - 1}, type text),
				    RokMiesiac = Table.AddColumn(MiesiacNazwa, "RokMiesiąc", each Text.From([Rok]) & "-" & Text.PadStart(Text.From([Miesiąc]), 2, "0"), type text),
				    RokMiesiacSort = Table.AddColumn(RokMiesiac, "RokMiesiącSort", each [Rok] * 100 + [Miesiąc], Int64.Type),
				    Etykieta = Table.AddColumn(RokMiesiacSort, "MiesiącRok", each [MiesiącNazwa] & " " & Text.End(Text.From([Rok]), 2), type text),
				    Poczatek = Table.AddColumn(Etykieta, "PoczątekMiesiąca", each Date.StartOfMonth([Data]), type date),
				    DzienNr = Table.AddColumn(Poczatek, "DzieńTygodniaNr", each Date.DayOfWeek([Data], Day.Monday) + 1, Int64.Type),
				    DzienNazwa = Table.AddColumn(DzienNr, "DzieńTygodnia", each DniTygodnia{[DzieńTygodniaNr] - 1}, type text),
				    CzySwieto = Table.AddColumn(DzienNazwa, "CzyŚwięto", each [NazwaŚwięta] <> null, type logical),
				    TypDnia = Table.AddColumn(CzySwieto, "TypDnia", each
				        if [CzyŚwięto] or [DzieńTygodniaNr] = 7 then "niedziela lub święto"
				        else if [DzieńTygodniaNr] = 6 then "sobota"
				        else "roboczy", type text),
				    TypDniaSort = Table.AddColumn(TypDnia, "TypDniaSort", each
				        if [TypDnia] = "roboczy" then 1 else if [TypDnia] = "sobota" then 2 else 3, Int64.Type),
				    RodzajDnia = Table.AddColumn(TypDniaSort, "RodzajDnia", each if [TypDnia] = "roboczy" then "dzień roboczy" else "weekend lub święto", type text),
				    Sezon = Table.AddColumn(RodzajDnia, "SezonGrzewczy", each List.Contains({10, 11, 12, 1, 2, 3, 4}, [Miesiąc]), type logical),
				    SezonEtykieta = Table.AddColumn(Sezon, "SezonGrzewczyEtykieta", each
				        if not [SezonGrzewczy] then "poza sezonem"
				        else
				            let r0 = if [Miesiąc] >= 10 then [Rok] else [Rok] - 1
				            in Text.From(r0) & "/" & Text.End(Text.From(r0 + 1), 2), type text),
				    Okno = Table.AddColumn(SezonEtykieta, "Okno12M", each fnOkno12M([Data]), type text),
				    OknoSort = Table.AddColumn(Okno, "OknoSort", each
				        if [Okno12M] = "Ostatnie 12 mies." then 1
				        else if [Okno12M] = "Poprzednie 12 mies." then 2
				        else if [Okno12M] = "Bieżący miesiąc" then 3 else 4, Int64.Type),
				    Granulacja = Table.AddColumn(OknoSort, "Granulacja", each if [Data] < #date(2025, 10, 1) then "1 h" else "15 min", type text)
				in
				    Granulacja

	annotation PBI_ResultType = Table

